<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.prioriza.controller.TaskFormController">

    <VBox spacing="10" layoutX="20" layoutY="20">

        <Label text="Nueva Tarea"
               style="-fx-font-size: 18px;" />

        <TextField fx:id="titleField"
                   promptText="Título de la tarea" />

        <TextArea fx:id="descriptionField"
                  promptText="Descripción..."
                  prefRowCount="3" />

        <DatePicker fx:id="datePicker" promptText="Fecha"/>

        <HBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Hora:"/>
            <TextField fx:id="hourField" promptText="HH:mm" prefWidth="80"/>
            <Label text="(formato 24h)" style="-fx-text-fill: gray; -fx-font-size: 10px;"/>
        </HBox>

        <Label text="Prioridad:"/>
        <ChoiceBox fx:id="priorityChoiceBox" prefWidth="150"/>

        <Label text="Importante:"/>
        <CheckBox fx:id="importantCheckBox" text="Marcar como importante"/>

        <ChoiceBox fx:id="statusChoiceBox" />

        <HBox spacing="10">
            <Button text="Guardar"
                    onAction="#handleSave" />
            <Button text="Cancelar"
                    onAction="#handleCancel" />
        </HBox>

    </VBox>

</AnchorPane>